.env
.env.*
!.env.example
node_modules
openspec
.DS_Store

# Computer Use runtime (auto-generated)
.runtime/
extracted-natives/

# Adapter attachment cache (created at runtime by AttachmentStore when
# running adapter tests or the feishu/telegram adapters locally)
.lark-attachments/
.tg-attachments/

# Playwright MCP snapshots & logs
.playwright-mcp/

# OMX state/logs
.omx/

# E2E screenshots
e2e-*.png

# Local/generated artifacts
artifacts/

# Shared local issue-router state (all worktrees use the primary checkout)
/.issue-router/

# Desktop build output
desktop/dist/
desktop/electron-dist/
desktop/build-artifacts/
desktop/src-tauri/binaries/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/package-lock.json

# Desktop brand asset candidates (keep only selected ones in public/)
desktop/brand-assets/

# Claude local config & auto-generated
.claude/

# Superpowers plans & specs (local only)
docs/superpowers/
.superpowers/

# Temp server/web logs
.tmp-*.log

# Debug / temp screenshots (root dir only)
/*.png
bug_attachments/

# Private keys & credentials
*.pem
*.key
*.p12
credentials*.json

# TS build cache
*.tsbuildinfo

# TS 编译产物（.ts/.tsx 旁边的同名 .js/.js.map/.d.ts）
# 源文件是 .ts/.tsx；这些是 build 输出，防止再以未跟踪状态出现
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
desktop/**/*.js
desktop/**/*.js.map
desktop/**/*.d.ts
mobile/**/*.js
mobile/**/*.js.map
mobile/**/*.d.ts
scripts/**/*.js
scripts/**/*.js.map
site/**/*.js
site/**/*.js.map
tests/**/*.js
adapters/**/*.js
adapters/**/*.js.map
adapters/**/*.d.ts
stubs/**/*.js
preload.js
preload.js.map

# Temp markdown snapshots
sidebar-snapshot.md

runtime/__pycache__

# IDE
.idea

# Codex logs
.codex-logs/

# Local AI assistant artifacts (graph, notes)
CLAUDE.md
.mavis/
.opencode/
graphify-out/

.learnings/

# Computer Use native helper build output (SwiftPM)
native/cu-helper/.build/
