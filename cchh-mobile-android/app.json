{
  "expo": {
    "name": "CCHH Mobile",
    "slug": "cchh-mobile",
    "version": "0.1.4",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.cchh.mobile.client",
      "permissions": [
        "INTERNET"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
